{
  "description": "Audit MCP helper candidates at Codex subagent lifecycle boundaries.",
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CODEX_MCP_GUARD_HOOK=1 python3 \"$PLUGIN_ROOT/scripts/hook.py\"",
            "commandWindows": "set \"CODEX_MCP_GUARD_HOOK=1\" && python \"%PLUGIN_ROOT%\\scripts\\hook.py\"",
            "timeout": 15,
            "statusMessage": "Recording MCP helper baseline"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CODEX_MCP_GUARD_HOOK=1 python3 \"$PLUGIN_ROOT/scripts/hook.py\"",
            "commandWindows": "set \"CODEX_MCP_GUARD_HOOK=1\" && python \"%PLUGIN_ROOT%\\scripts\\hook.py\"",
            "timeout": 15,
            "statusMessage": "Comparing MCP helper snapshot"
          }
        ]
      }
    ]
  }
}
